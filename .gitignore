# 多副本验证脚本产生的临时日志
.replica_*.log
.fullstack_*.log

# 本地持久化数据库文件（非源码，由 init_db 自动生成）
*.db
agent.db
test_agent.db

# dev/demo 随机 JWT 密钥（由 config 自动生成，禁止入库）
.jwt_secret

# ---- 非作品集交付物（内部/团队文档，不进作品集仓库）----
# 团队技术提升方案是按「团队带练/8 周路线图」假设写的，对单人作品集不适用
团队技术提升方案.md
# 内部项目路线图 HTML，非对外展示材料
docs/agent-project-roadmap.html

# 预下载的 Linux 轮子（仅本地/内网离线构建用，不入库；保留 .gitkeep 让 CI 也能 COPY 到空目录）
wheels/*
!wheels/.gitkeep

# 验证脚本本地运行产物（报告/日志，不入库）
verify_monitoring_report.txt
verify_fullstack_report.txt
.fullstack_*.log