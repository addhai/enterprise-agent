# =============================================================================
# Enterprise Agent - 生产环境变量模板
# 复制为 .env.production 后填入实际值
# 所有标注 [必须修改] 的变量不可用默认值上线
# =============================================================================

# ---- 密钥类（[必须修改]） ----
# JWT 签名密钥：32 字节以上随机字符串，多副本必须一致
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=changeme-jwt-secret-32-bytes-minimum  # [必须修改]
# JWT_SECRET= 生产环境必须设置，openssl rand -hex 32 生成；不设则容器启动生成一次性 dev 密钥，重建后 token 全失效

# PostgreSQL 密码
POSTGRES_PASSWORD=changeme-pg-password  # [必须修改]
POSTGRES_USER=postgres
POSTGRES_DB=agent

# LLM API Key（百炼兼容 OpenAI 格式）
# 内网部署用 Ollama 本地模型，此项可空
# 云端部署必须填入
OPENAI_API_KEY=  # [按需填写]

# ---- 模型配置 ----
# 内网部署（Ollama 本地）
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3
OPENAI_API_BASE=http://127.0.0.1:11434/v1

# 云端部署（阿里云百炼）
# LLM_MODEL=qwen-plus
# EMBEDDING_MODEL=text-embedding-v4
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# ---- 服务端口 ----
HOST_PORT=8000

# ---- RAG 优化开关（P3-3 集成） ----
# 查询改写：默认开启，关闭后检索用原始查询
REWRITE_ENABLED=true
# 文档权重：按 source 文件名设置，格式 "file.md:weight,file2.md:weight"
DOC_WEIGHTS=fault_troubleshooting_manual.md:1.5,product_spec_manual.md:1.3,calibration_guide.md:1.2,faq_full.md:0.8,application_guide.md:0.9

# ---- 检索配置 ----
RETRIEVAL_SOURCE_CAP=2
MAX_UPLOAD_SIZE=10485760  # 10MB，单位字节

# ---- Ollama 配置 ----
# OLLAMA_BASE_URL 由 docker-compose.prod.yml 第 41 行统一注入，如需覆盖才在此取消注释
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# ---- 监控与追踪 ----
LANGSMITH_TRACING=false  # 生产环境可开启用于排查
EVAL_LLM_JUDGE_ENABLED=false
EVAL_ONLINE_SAMPLING_RATE=0.0

# ---- 健康探测 ----
# 由 docker-compose.prod.yml 第 61 行引用，未定义时 compose 会输出告警
AGENT_PROBE_ENABLED=false
