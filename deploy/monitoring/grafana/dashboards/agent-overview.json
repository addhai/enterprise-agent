{
  "uid": "enterprise-agent",
  "title": "Enterprise Agent — Service Overview",
  "tags": ["enterprise-agent", "ai", "customer-service"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {
      "id": 1,
      "title": "Services Status",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 0, "w": 24, "h": 2},
      "targets": [
        {
          "refId": "A",
          "expr": "count(up == 1) / count(up)",
          "legendFormat": "Uptime Ratio"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.99}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "API Requests per Second",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 2, "w": 8, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"api\"}[1m])) by (endpoint)",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "API Latency (P50/P95/P99)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 2, "w": 8, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])) by (le))",
          "legendFormat": "P50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])) by (le))",
          "legendFormat": "P95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket{service=\"api\"}[5m])) by (le))",
          "legendFormat": "P99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 2, "fillOpacity": 10}
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "HTTP Status Distribution",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 2, "w": 8, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_requests_total{service=\"api\"}[1m])) by (status)",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 20}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "LLM Call Success Rate",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 8, "w": 4, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_calls_success_total[5m])) / sum(rate(llm_calls_total[5m]))",
          "legendFormat": "LLM Success Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "yellow", "value": 0.9},
              {"color": "green", "value": 0.98}
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Active WebSocket Connections",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 4, "y": 8, "w": 4, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ws_active_connections) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 500},
              {"color": "red", "value": 800}
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "RabbitMQ Queue Depth",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 8, "w": 8, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "rabbitmq_queue_messages_ready{queue=~\"agent.*\"}",
          "legendFormat": "{{queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 20}
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "RAG Search Latency (P95)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 8, "w": 8, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(rag_search_duration_seconds_bucket[5m])) by (le, backend))",
          "legendFormat": "P95 {{backend}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Milvus Collection Stats",
      "type": "stat",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 14, "w": 4, "h": 4},
      "targets": [
        {
          "refId": "A",
          "expr": "milvus_num_entities{collection_name=\"knowledge_chunks\"}",
          "legendFormat": "Total Chunks"
        }
      ],
      "fieldConfig": {
        "defaults": {"unit": "short"},
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "Redis Memory Usage",
      "type": "gauge",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 4, "y": 14, "w": 4, "h": 4},
      "targets": [
        {
          "refId": "A",
          "expr": "redis_memory_used_bytes / redis_memory_max_bytes",
          "legendFormat": "Memory %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 0.7},
              {"color": "red", "value": 0.85}
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "Conversation Quality & Resolution",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 8, "y": 14, "w": 8, "h": 4},
      "targets": [
        {
          "refId": "A",
          "expr": "agent_quality_score_avg",
          "legendFormat": "Quality Score (avg)"
        },
        {
          "refId": "B",
          "expr": "agent_resolution_rate",
          "legendFormat": "Resolution Rate"
        },
        {
          "refId": "C",
          "expr": "agent_escalation_rate",
          "legendFormat": "Escalation Rate"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 1,
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Alert Events (Firing)",
      "type": "table",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 16, "y": 14, "w": 8, "h": 4},
      "targets": [
        {
          "refId": "A",
          "expr": "ALERTS{alertstate=\"firing\"}",
          "format": "table",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "LLM Token Usage by Model (cost driver)",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 0, "y": 18, "w": 12, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_tokens_total[5m])) by (model, type)",
          "legendFormat": "{{model}} / {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 15}
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "LLM Token Usage by Tenant",
      "type": "timeseries",
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "gridPos": {"x": 12, "y": 18, "w": 12, "h": 6},
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(llm_tokens_total[5m])) by (tenant)",
          "legendFormat": "{{tenant}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {"lineWidth": 2, "fillOpacity": 15, "stacking": {"mode": "normal"}}
        },
        "overrides": []
      }
    }
  ]
}
