# =============================================================================
# Enterprise Agent - P2-4 环境变量配置
# 复制为 .env.p2 后填入实际值:  cp .env.p2.example .env.p2
# =============================================================================

# ---- LLM / Embedding ----
# 实际为阿里云百炼 DashScope key (兼容 OpenAI 接口格式)
OPENAI_API_KEY=sk-your-dashscope-key-here
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4

# ---- 服务端口 ----
HOST_PORT=8000

# ---- PostgreSQL ----
POSTGRES_DB=agent
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_PORT=5432

# ---- Redis ----
REDIS_PORT=6379

# ---- Agent 配置 ----
MAX_REASONING_TURNS=5

# ---- LangSmith (可选) ----
LANGSMITH_TRACING=false
